# Токен Telegram-бота от @BotFather
BOT_TOKEN=your_bot_token_here

# Логин и пароль для входа в админ-панель (по умолчанию buraq / buraq1234)
ADMIN_LOGIN=buraq
ADMIN_PASSWORD=your_secure_password_here
# Дополнительные аккаунты создаются ТОЛЬКО если заполнить эти переменные
# (по умолчанию выключены — активны два профиля: админ + ТВ-киоск sales)
ADMIN1_LOGIN=
ADMIN1_PASSWORD=
GUEST1_LOGIN=
GUEST2_LOGIN=
GUEST3_LOGIN=
GUEST_PASSWORD=

# Секретный ключ Flask (сгенерируй свой: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_this_to_random_string

# Публичный адрес сайта для webhook
WEBHOOK_BASE_URL=https://your-domain.up.railway.app

# Секрет для проверки webhook от Telegram
WEBHOOK_SECRET=change_this_to_long_random_string

# Порт приложения
PORT=8080

# Постоянная папка для базы и файлов.
# Для Railway удобно указать путь смонтированного Volume, например /app/data
APP_DATA_DIR=

# Необязательно: явный путь к SQLite-базе
DB_PATH=

# Необязательно: явный путь к папке загруженных файлов
UPLOAD_FOLDER=

# AI assistant (DeepSeek) — private-chat assistant for the owner
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
AI_ASSISTANT_ADMIN_IDS=303114354
AI_CONTROL_GROUP_ID=-1002653438323
# Шитс планов погрузки (по умолчанию — рабочий файл BURAQ)
LOADING_PLAN_SHEET_ID=

# Утренний сбор packing list в управляющей группе
PACKING_RESPONSIBLE_TG_ID=8526226966
PACKING_RESPONSIBLE_NAME=Jigar
PACKING_REMINDER_HOUR=9

# Утренний дайджест трекинга (личка ответственного)
TRACKING_DIGEST_TG_ID=7713376668
TRACKING_DIGEST_HOUR=9

# Просмотровый доступ к ассистенту (без права изменений)
AI_ASSISTANT_READONLY_IDS=7713376668
# Строго конфиденциальные чаты — бот туда никогда не пишет
CONFIDENTIAL_CHAT_IDS=-1002687342009
# Утренний запрос обновления трекинга (форма в управляющей группе)
TRACKING_ASK_HOUR=7
# Короткое имя Mini App из BotFather (/newapp) для direct-link кнопок в группах
TGFORM_APP_SHORTNAME=form
